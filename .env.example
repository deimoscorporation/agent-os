# Copie para `.env` e ajuste. Em desenvolvimento, nada aqui é obrigatório.
# O arquivo `.env` é carregado automaticamente e nunca deve ser versionado.

# ---------------------------------------------------------------- Django
# Em produção: false. Com false, DJANGO_SECRET_KEY e DEIMOS_SECRETS_KEY passam a ser obrigatórias.
DJANGO_DEBUG=true

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Domínios que servem a aplicação, separados por vírgula. Ex.: agentos.suaempresa.com
DJANGO_ALLOWED_HOSTS=
# Origens confiáveis para formulários, com esquema. Ex.: https://agentos.suaempresa.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Só em produção (DJANGO_DEBUG=false):
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_TIME_ZONE=America/Sao_Paulo

# ---------------------------------------------------- Criptografia de segredos
# Protege o cofre dos workspaces e as chaves de API dos usuários.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: guarde esta chave com backup. Trocá-la torna ilegíveis os segredos já salvos.
DEIMOS_SECRETS_KEY=

# ---------------------------------------------------------------- OpenAI
# Cada usuário cadastra a própria chave em "Minha conta". As opções abaixo são da instância.

# Endereço da API. Aceita qualquer servidor compatível com a API da OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Modelos oferecidos antes de a chave do usuário ser validada; o primeiro é o padrão.
# OPENAI_MODELS=gpt-5-mini,gpt-5,gpt-4.1,gpt-4o-mini

# Opcional: chave compartilhada, usada por quem não cadastrou a sua.
# Deixe vazio para exigir que cada pessoa use a própria chave (recomendado).
OPENAI_API_KEY=

# ---------------------------------------------------------------- Armazenamento
# DEIMOS_DATABASE_PATH=/var/lib/agent-os/agent_os.sqlite3
# DEIMOS_MEDIA_ROOT=/var/lib/agent-os/media
